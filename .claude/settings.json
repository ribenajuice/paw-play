{
  "permissions": {
    "allow": [
      "Bash(./gradlew lint*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew assemble*)",
      "Bash(./gradlew build*)",
      "Bash(godot --headless*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh secret list:*)",
      "Bash(gh variable list:*)",
      "Bash(gh repo view:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/local.properties)"
    ]
  }
}
